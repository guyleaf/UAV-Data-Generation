// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${devcontainerId}-persistence,target=/persistence,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/root/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/data,target=/root/data,type=bind,consistency=cached",
    "source=${localEnv:HOME}/work,target=/root/work,type=bind,consistency=cached",
    "source=${localEnv:HOME}/archive,target=/root/archive,type=bind,consistency=cached"
  ],
  "runArgs": [
    "--runtime=nvidia",
    "--gpus",
    // "all",
    "\"device=0,1,2,3\"",
    "--shm-size=1g"
  ],

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "rm -rf .venv && ./scripts/setup_venv.sh",

  // Configure tool-specific properties.
  // "customizations": {},

  // Must set these settings below if using rootless docker
  "remoteUser": "root",
  "containerEnv": {
    "OMPI_ALLOW_RUN_AS_ROOT": "1",
    "OMPI_ALLOW_RUN_AS_ROOT_CONFIRM": "1",
    // Allow using OPTIX in container
    "NVIDIA_DRIVER_CAPABILITIES": "graphics,compute,utility"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/root/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "none"
}
